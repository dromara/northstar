{
  "name": "cartpole-dqn",
  "version": 1,
  "state_dim": 4,
  "action_dim": 2,
  "actions": ["LEFT", "RIGHT"],
  "hidden": 128,
  "model_file": "model.pt",
  "data_file": "replay.csv",
  "preprocessing": {
    "type": "identity"
  },
  "training": {
    "gamma": 0.99,
    "lr": 0.0005,
    "batch_size": 128,
    "buffer_capacity": 100000,
    "min_buffer": 1000,
    "tau": 0.005
  }
}
